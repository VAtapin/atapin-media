APP_NAME="Atapin Media"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mannavomhimmel.de
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://mannavomhimmel.de/desktop/publishing/youtube/callback
YOUTUBE_SYNC_DOWNLOADER=yt-dlp
META_GRAPH_API_VERSION=v23.0
LIVE_RELAY_FFMPEG=ffmpeg
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
PLATFORM_BRAND="Manna Vom Himmel"
PLATFORM_THEME=manna
PLATFORM_TIMEZONE=Europe/Berlin
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
MAIL_MAILER=log
LIVE_RTMP_HOST=mannavomhimmel.de
LIVE_RTMP_PORT=1936
# Keep the certificate and private key outside Git, readable by the Plesk subscription user.
LIVE_RTMP_CERT=/var/www/vhosts/mannavomhimmel.de/private/atapin-live/rtmps.crt
LIVE_RTMP_KEY=/var/www/vhosts/mannavomhimmel.de/private/atapin-live/rtmps.key
